# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────
# recued-server — thin `:managed` self-updating image (D-178, I-9)
#
# The `:managed` image is a DUMB, FROZEN verify-and-exec launcher. Unlike the
# baked `:vX.Y.Z` / `:stable` images (which are the whole server and update by
# pull-and-recreate), this image's server BINARY lives on the DATA VOLUME at
# `/data/bin/recued` and self-updates in place (the running server's
# `update.apply` downloads → verifies → swaps the volume binary → exits; the
# launcher re-verifies and re-execs on restart).
#
# What's baked here, and only here:
#   - the launcher bundle (`dist/managed-launcher.js`) — the entrypoint;
#   - an INITIAL server binary seed (`/opt/recued-seed/`) the launcher copies
#     onto an empty volume on first boot.
#
# The launcher NEVER self-updates (I-9). Re-pull this image only when the
# manifest's `min_launcher_version` says the verification contract changed —
# digest-anchored, per the signed manifest.
#
# R26.2 Delta 3 — the embedded webclient is NOT baked here (deliberately).
# Unlike the baked `:vX.Y.Z` image (which bakes a version-matched webclient via
# RECUED_WEBCLIENT_DIR), this image's server binary self-updates IN PLACE on the
# data volume — a webclient baked into this frozen launcher would go stale after
# the first self-update, REINTRODUCING the version skew the embed exists to
# dissolve. So the managed webclient travels WITH the signed release artifact:
# the manifest carries a `webclient` artifact (D-178 + D-152 § A.16) that
# `update.apply` downloads, minisign-verifies, and extracts to the webclient dir
# after the binary swap (backend/server/src/update/webclient-sync.ts), keeping it
# version-matched across self-updates. With RECUED_WEBCLIENT_DIR unset (below),
# that dir resolves to a `webclient` sibling of the CAS root on the data volume —
# the SAME dir the server's boot loader reads — so no operator action is needed
# beyond a signed release feed being configured.
#
# Exit-code contract: the launcher runs the server under the `docker-thin`
# supervisor (STANDARD codes — restart stays 3, NOT the plain-docker 3→1 remap)
# so the launcher loop distinguishes restart-intent / crash / clean / lock-held.
# ─────────────────────────────────────────────────────────────────

# ── Stage 1: deps ────────────────────────────────────────────────
FROM node:22-slim AS deps
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/recued
COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY backend/server/package.json ./backend/server/
COPY packages/ ./packages/
COPY apps/ ./apps/
RUN npm ci --ignore-scripts
# ⛔ NO native rebuild here, deliberately — unlike the baked `Dockerfile`. This
# image ships only `managed-launcher.js` (node builtins only) and a static seed
# binary that carries its own runtime; nothing in it resolves a `.node` from
# node_modules, and `build.mjs` needs esbuild, not SQLite. The line that used to
# sit here rebuilt plain `better-sqlite3` — which D-212 demoted to dev-only
# anyway — and bought nothing but build time.

# ── Stage 2: build ───────────────────────────────────────────────
FROM deps AS build
COPY backend/server/ ./backend/server/
COPY community/ ./community/
WORKDIR /opt/recued/backend/server
RUN node scripts/build.mjs

# ── Stage 3: runtime (thin launcher + seed) ──────────────────────
FROM node:22-slim AS runtime
RUN groupadd --system --gid 1001 recued \
    && useradd --system --uid 1001 --gid recued \
               --home /var/lib/recued recued \
    && mkdir -p /data /opt/recued-seed \
    && chown -R recued:recued /data /opt/recued-seed

WORKDIR /opt/recued

# The launcher bundle (the entrypoint). Self-contained — bundles @recued/release
# (the frozen minisign verifier); needs no node_modules of its own.
COPY --from=build --chown=recued:recued \
     /opt/recued/backend/server/dist/managed-launcher.js ./managed-launcher.js

# ⛔ The server bundle + node_modules are NO LONGER COPIED. They existed only to
# back the node-exec shim that used to be the seed; the seed is now the static
# binary, which carries its own runtime. Verified before removal rather than
# assumed: the emitted `managed-launcher.js` is 14 KB and imports node builtins
# ONLY — no `better-sqlite3`, no `ws`, nothing resolvable from node_modules —
# even though it inherits the build's `external` list, which would have made it
# need them. Keeping them would have shipped hundreds of MB of a server the
# launcher never runs.
# ── The first-boot seed: a SIGNED release payload, exe + native addon ────
#
# D-178 S1 rev 2 item 7. `TRUSTED_RELEASE_PUBKEY` was pinned on 2026-07-31, so
# the launcher's first-boot verify is LIVE — the seed must be the signed static
# binary from a published release, not the node-exec shim this used to write.
# And it is TWO files: the SEA cannot embed a `.node`, so the addon is baked at
# the same relative path the launcher reads (`ADDON_RELATIVE_PATH`).
#
# ⚠ THIS IMAGE IS BUILT FROM A RELEASE, NOT FROM SOURCE. `RELEASE_DIR` must
# point at the output of `release-build.mjs` (default `dist/release`), inside
# the build context. A plain source checkout has no such directory and the build
# will stop at the COPY below — that is intended; see verify-managed-seed.sh.
# ⛔ The triple is DERIVED from `TARGETARCH`, never passed as a build arg. One
# `--platform linux/amd64,linux/arm64` invocation builds both images from ONE
# set of args, so a `TRIPLE` arg bakes the same binary into both — and the arm64
# image would seed an x86-64 executable that dies with `exec format error` on a
# user's first boot. See stage-managed-seed.sh.
# Relative to the BUILD CONTEXT (the repo root), not to this file — and
# `npm run release:build` runs with cwd = backend/server, so its `dist/release`
# lands here rather than at the repo root.
ARG RELEASE_DIR=backend/server/dist/release
COPY ${RELEASE_DIR}/ /tmp/release/
COPY distribution/docker/stage-managed-seed.sh  /tmp/stage-managed-seed.sh
COPY distribution/docker/verify-managed-seed.sh /tmp/verify-managed-seed.sh
COPY --from=build /opt/recued/backend/server/src/update/trusted-release-pubkey.ts /tmp/pin.ts

ARG TARGETARCH
RUN sh /tmp/stage-managed-seed.sh /tmp/release "$TARGETARCH" /opt/recued-seed \
 && pin="$(sed -n "s/.*TRUSTED_RELEASE_PUBKEY = '\([^']*\)'.*/\1/p" /tmp/pin.ts)" \
 && sh /tmp/verify-managed-seed.sh /opt/recued-seed "$pin" /tmp/release \
 && chown -R recued:recued /opt/recued-seed \
 && rm -rf /tmp/release /tmp/stage-managed-seed.sh /tmp/verify-managed-seed.sh /tmp/pin.ts

USER recued

ENV RECUED_SUPERVISOR_MODE=docker-thin \
    RECUED_BIN_DIR=/data/bin \
    RECUED_SEED_BIN=/opt/recued-seed/recued \
    NODE_ENV=production

EXPOSE 7717 7718 7719
VOLUME ["/data"]

# ⛔ NOT `wget` — it is NOT preinstalled on node:22-slim, so this check always
# failed and the container reported `unhealthy` while serving 200s. See the
# longer note in the baked `Dockerfile`; both images had the same bug and the
# same wrong comment. `node` is guaranteed present: the launcher runs under it,
# and it stays in the image after the seed self-updates to the SEA binary.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:7717/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["node", "/opt/recued/managed-launcher.js"]
CMD ["--db", "/data/recued.db", "--config", "/etc/recued/config.toml"]

LABEL org.opencontainers.image.title="recued-server (managed)" \
      org.opencontainers.image.description="Thin self-updating launcher — binary on the data volume (D-178)" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.source="https://github.com/recued/recued" \
      org.opencontainers.image.url="https://recued.com"
