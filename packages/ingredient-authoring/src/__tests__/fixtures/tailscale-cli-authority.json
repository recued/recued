    "source_decision": {
      "admitted": false,
      "candidates": [],
      "reason": "Local Tailscale device, peer, account, DNS, routing, service, and security diagnostics are control-plane observations rather than semantically honest task, note, commitment, or user-work project Sources."
    },
    "audit_findings_folded": [
      {
        "severity": "HIGH",
        "finding": "The Tailscale API and local CLI share a brand but have different runtime, identity, and trust boundaries.",
        "resolution": "Ship tailscale-cli independently with system_binary:tailscale and no dependency, connection requirement, or credential argument from tailscale-api."
      },
      {
        "severity": "HIGH",
        "finding": "Most CLI commands depend on a privileged local daemon whose implementation differs across Linux, macOS variants, and Windows.",
        "resolution": "Probe only the portable tailscale binary, declare daemon readiness explicitly, use the default local socket, and never admit a caller-selected --socket path."
      },
      {
        "severity": "HIGH",
        "finding": "Several top-level commands authenticate, disconnect, rewrite routing/firewall settings, or can cut off the host running Recued.",
        "resolution": "Exclude up, down, login, logout, and set entirely instead of attempting a broad safe-looking flag subset."
      },
      {
        "severity": "HIGH",
        "finding": "SSH, nc, web, systray, and wait are interactive, server-starting, GUI, streaming, or potentially indefinite surfaces.",
        "resolution": "Admit only finite foreground value-returning invocations with no stdin, detach, listener, shell, or streaming mode."
      },
      {
        "severity": "HIGH",
        "finding": "Certificate, Taildrop, and Taildrive commands can create private keys or read/write local and remote files.",
        "resolution": "Exclude cert, file, and drive until a separate file_ref and secret-output design can prove materialization, ownership, and non-persistence."
      },
      {
        "severity": "HIGH",
        "finding": "Serve, Funnel, and Tailnet Lock command families combine useful reads with public exposure and security-authority mutations.",
        "resolution": "Admit only JSON status and a fixed 50-entry Tailnet Lock log; exclude every reset, target, config, advertise, key, disable, sign, and revoke mutation."
      },
      {
        "severity": "MEDIUM",
        "finding": "Tailscale marks status JSON subject to change and netcheck JSON not yet stable.",
        "resolution": "Pin the current official docs, label both capabilities unstable, return provider JSON without a brittle response schema, and fail regeneration on documentation drift."
      },
      {
        "severity": "MEDIUM",
        "finding": "Netcheck and ping actively probe network paths and can reveal public addressing, NAT, relay, and topology evidence.",
        "resolution": "Require approval, disable repeating/verbose/bind controls, bound ping to three attempts and five seconds each, and disable the until-direct extension."
      },
      {
        "severity": "MEDIUM",
        "finding": "Daemon-backed reads expose peer names, owner identities, accounts, policies, routes, services, traffic counters, and key metadata.",
        "resolution": "Require approval and zero cache for every capability except the local CLI version."
      },
      {
        "severity": "MEDIUM",
        "finding": "DNS query and peer selectors could become arbitrary argv or option injection if accepted as free-form command fragments.",
        "resolution": "Use discrete argv holes, reject dash/URL/whitespace/path syntax, and constrain DNS record types to a closed eight-value enum."
      },
      {
        "severity": "MEDIUM",
        "finding": "Tailnet Lock logs and App Connector routes can grow or disclose security topology.",
        "resolution": "Fix the authority log limit at 50, keep routes read-only, require approval, and prohibit caller-supplied flags."
      },
      {
        "severity": "MEDIUM",
        "finding": "A local binary probe must not depend on login state or daemon availability or pack installation would false-fail.",
        "resolution": "Probe tailscale version --json only; model daemon and enrollment as operation-time readiness requirements."
      },
      {
        "severity": "MEDIUM",
        "finding": "The official CLI reference contains 33 top-level command roots, but claiming all of them would misrepresent unsafe and unsupported execution modes.",
        "resolution": "Record an exact 15-admitted/18-excluded command-root partition and test that every official root has one explicit decision."
      },
      {
        "severity": "MEDIUM",
        "finding": "Local node, network, account, and security status are not task, note, commitment, or user-work project records.",
        "resolution": "Declare no work_entity_sources and bundle no automatic or chat workflow that could leak private local diagnostics."
      }
    ],
    "operations_sha256": "bbc84952168700ec0544458c147ad7e27142b3c2ff92b9984f8e83d87ba817d8"
  },
