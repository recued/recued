{
  // A part of the test type-check: tsconfig.test.json's apps/ patterns, checked as a
  // program of their own by test/typecheck-tests.mjs, which says why.
  "extends": "./tsconfig.test.json",
  "include": [
    "apps/**/src/**/*.test.ts",
    "apps/**/src/**/*.test.tsx",
    "apps/**/src/**/__tests__/**/*.ts",
    "apps/**/src/**/__tests__/**/*.tsx"
  ]
}
