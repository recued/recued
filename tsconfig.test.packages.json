{
  // A part of the test type-check: tsconfig.test.json's packages/ patterns, checked
  // as a program of their own by test/typecheck-tests.mjs, which says why.
  "extends": "./tsconfig.test.json",
  "include": [
    "packages/**/src/**/*.test.ts",
    "packages/**/src/**/*.test.tsx",
    "packages/**/src/**/__tests__/**/*.ts",
    "packages/**/src/**/__tests__/**/*.tsx"
  ]
}
