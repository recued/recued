{
  "recipe_id": "find-paperless-documents",
  "version": 5,
  "chat_exposed": false,
  "ttl": 0,
  "metadata": {
    "name": "Find Paperless documents",
    "description": "Use “Find Paperless documents” in Recued. Search one page at a time. Review one document or the displayed batch before connecting it.",
    "author": "recued-core",
    "supported_platforms": [
      "paperless-ngx"
    ],
    "recipe_bundle": "recued-core/paperless-ngx",
    "tags": [
      "pack:paperless-ngx",
      "documents",
      "sync"
    ],
    "budget_ms": 120000,
    "retired_connections": {
      "paperless_ngx": "paperless-ngx-api"
    }
  },
  "depends_on": [
    "recued-core.paperless-ngx",
    "recued-core.paperless-ngx-api"
  ],
  "requires": [
    "read_connection_paperless_ngx"
  ],
  "variables": {
    "custom_field_id": {
      "label": "Document date field",
      "type": "number"
    },
    "query": {
      "label": "Search",
      "type": "string",
      "default": ""
    },
    "page": {
      "label": "Page",
      "type": "number",
      "default": 1
    }
  },
  "steps": [
    {
      "id": "connection_required",
      "guard": "{{context.connections.paperless-ngx-api}} is_empty",
      "fail_reason": "Choose the enrolled Paperless connection for this recipe."
    },
    {
      "id": "documents",
      "op": "recued-core.paperless-ngx-api.document.list",
      "args": {
        "query.query": "{{config.query}}",
        "query.page": "{{config.page}}",
        "query.page_size": 50
      },
      "cache": "fresh"
    },
    {
      "id": "rows",
      "transform": "map",
      "array": "{{step.documents.result.results}}",
      "expression": {
        "id": "{{item.id}}",
        "title": "{{item.title}}",
        "actions": [
          {
            "kind": "recipe.run",
            "label": "Review",
            "recipe_id": "preview-paperless-sync",
            "config": {
              "document_ids": [
                "{{item.id}}"
              ],
              "custom_field_id": "{{config.custom_field_id}}"
            }
          },
          {
            "kind": "recipe.run",
            "label": "Ignore",
            "recipe_id": "ignore-paperless-document",
            "config": {
              "document_id": "{{item.id}}",
              "custom_field_id": "{{config.custom_field_id}}"
            }
          }
        ]
      }
    },
    {
      "id": "table",
      "transform": "to_table",
      "array": "{{step.rows}}",
      "columns": [
        {
          "field": "title",
          "label": "Document"
        },
        {
          "field": "actions",
          "label": "",
          "type": "action"
        }
      ]
    },
    {
      "id": "ids",
      "transform": "pluck",
      "array": "{{step.documents.result.results}}",
      "field": "id"
    },
    {
      "id": "document_count",
      "transform": "count",
      "input": "{{step.ids}}"
    },
    {
      "id": "next_page",
      "transform": "math",
      "operator": "add",
      "left": "{{config.page}}",
      "right": 1
    },
    {
      "id": "more",
      "transform": "ternary",
      "if": "{{step.documents.result.next}}",
      "then": [
        {
          "kind": "recipe.run",
          "label": "Next page",
          "recipe_id": "find-paperless-documents",
          "config": {
            "custom_field_id": "{{config.custom_field_id}}",
            "query": "{{config.query}}",
            "page": "{{step.next_page}}"
          }
        }
      ],
      "else": []
    },
    {
      "id": "batch",
      "transform": "ternary",
      "if": "{{step.document_count}}",
      "then": [
        {
          "kind": "recipe.run",
          "label": "Review this page",
          "recipe_id": "preview-paperless-sync",
          "config": {
            "document_ids": "{{step.ids}}",
            "custom_field_id": "{{config.custom_field_id}}"
          }
        }
      ],
      "else": []
    },
    {
      "id": "actions",
      "transform": "flatten",
      "array": [
        "{{step.batch}}",
        "{{step.more}}"
      ]
    }
  ],
  "output": {
    "render": [
      {
        "type": "table",
        "source": "step.table"
      },
      {
        "type": "button",
        "source": "step.actions"
      }
    ]
  }
}
