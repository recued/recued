{
  "recipe_id": "reschedule-calendar-event",
  "chat_exposed": false,
  "version": 1,
  "ttl": 60,
  "requires": [],
  "metadata": {
    "name": "Reschedule a calendar event",
    "description": "Use “Reschedule a calendar event” in Recued. It carries out the named workflow using the connections and settings you choose.",
    "author": "recued-core",
    "supported_platforms": [],
    "tags": [
      "calendar",
      "reschedule",
      "booking",
      "reception",
      "owner-action"
    ],
    "budget_ms": 20000
  },
  "variables": {
    "calendar_slug": {
      "label": "Calendar instance slug",
      "type": "string",
      "default": ""
    },
    "event_source_id": {
      "label": "Event source id",
      "type": "string",
      "default": ""
    },
    "new_start_at": {
      "label": "New start (unix ms)",
      "type": "number",
      "default": null
    },
    "new_end_at": {
      "label": "New end (unix ms)",
      "type": "number",
      "default": null
    }
  },
  "steps": [
    {
      "id": "ready",
      "transform": "all",
      "conditions": [
        "{{config.calendar_slug}} is_not_empty",
        "{{config.event_source_id}} is_not_empty",
        "{{config.new_start_at}} is_not_null",
        "{{config.new_end_at}} is_not_null"
      ]
    },
    {
      "id": "reschedule",
      "skip_when": "{{step.ready}} not_equal true",
      "op": "core.data.calendar.update",
      "args": {
        "slug": "{{config.calendar_slug}}",
        "source_id": "{{config.event_source_id}}",
        "patch": {
          "start_at": "{{config.new_start_at}}",
          "end_at": "{{config.new_end_at}}"
        }
      }
    },
    {
      "id": "moved",
      "transform": "compare",
      "left": "{{step.reschedule.source_id}}",
      "operator": "is_not_null"
    },
    {
      "id": "card",
      "transform": "to_summary",
      "fields": [
        {
          "label": "Event",
          "value": "{{config.event_source_id}}"
        },
        {
          "label": "Rescheduled",
          "value": "{{step.moved}}"
        },
        {
          "label": "New start",
          "value": "{{config.new_start_at:date}}"
        },
        {
          "label": "New end",
          "value": "{{config.new_end_at:date}}"
        }
      ]
    }
  ],
  "output": {
    "render": [
      {
        "type": "summary",
        "source": "step.card"
      }
    ]
  }
}
