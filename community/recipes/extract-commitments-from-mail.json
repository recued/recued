{
  "recipe_id": "extract-commitments-from-mail",
  "chat_exposed": true,
  "version": 2,
  "ttl": 60,
  "metadata": {
    "name": "Extract commitments from mail",
    "description": "Use “Extract commitments from mail” in Recued. Extract commitments from an inbound email into Recued's commitment tracker — who promised what to whom, with optional deadline and monetary amount. Thread-aware: a reply like ‘yes, please send that by Friday’ binds to the prior message. Records one only when someone actually promised something.",
    "author": "recued-core",
    "supported_platforms": [],
    "tags": [
      "email",
      "mail",
      "commitment",
      "work-entity",
      "reactive",
      "silent-producer",
      "pack:personal-organizer",
      "ai_surface"
    ],
    "budget_ms": 30000
  },
  "variables": {},
  "requires": [],
  "event_triggers": [
    {
      "event": "data.mail.**.created"
    }
  ],
  "prefetch_steps": [
    {
      "id": "message",
      "op": "core.mail.get",
      "args": {
        "slug": "{{context.event.payload.slug}}",
        "record_id": "{{context.event.payload.record_id}}"
      }
    }
  ],
  "steps": [
    {
      "id": "defaults",
      "transform": "defaults",
      "fields": {
        "subject": {
          "value": "{{step.message.record.hot_fields.subject}}",
          "fallback": ""
        },
        "from_email": {
          "value": "{{step.message.record.hot_fields.from}}",
          "fallback": ""
        },
        "thread_id": {
          "value": "{{step.message.record.hot_fields.thread_id}}",
          "fallback": ""
        }
      }
    },
    {
      "id": "has_thread_id",
      "transform": "compare",
      "left": "{{step.thread_id}}",
      "operator": "is_not_empty"
    },
    {
      "id": "thread",
      "skip_when": "{{step.has_thread_id}} not_equal true",
      "op": "core.mail.thread-read",
      "args": {
        "slug": "{{context.event.payload.slug}}",
        "thread_id": "{{step.thread_id}}",
        "max_messages": 5
      }
    },
    {
      "id": "thread_messages",
      "transform": "default",
      "value": "{{step.thread.messages}}",
      "fallback": []
    },
    {
      "id": "thread_body_reads",
      "op": "core.mail.body-read",
      "foreach": "{{step.thread_messages}}",
      "args": {
        "slug": "{{context.event.payload.slug}}",
        "record_id": "{{item.record_id}}",
        "max_chars": 32000
      }
    },
    {
      "id": "thread_messages_with_body",
      "transform": "filter",
      "array": "{{step.thread_body_reads}}",
      "field": "result.body",
      "operator": "is_not_empty"
    },
    {
      "id": "thread_body_segments",
      "transform": "pluck",
      "array": "{{step.thread_messages_with_body}}",
      "field": "result.body"
    },
    {
      "id": "thread_body",
      "transform": "join",
      "array": "{{step.thread_body_segments}}",
      "separator": "\n\n---\n\n"
    },
    {
      "id": "single_body_read",
      "skip_when": "{{step.has_thread_id}} equal true",
      "op": "core.mail.body-read",
      "args": {
        "slug": "{{context.event.payload.slug}}",
        "record_id": "{{context.event.payload.record_id}}",
        "max_chars": 32000
      }
    },
    {
      "id": "single_body",
      "transform": "default",
      "value": "{{step.single_body_read.body}}",
      "fallback": ""
    },
    {
      "id": "body",
      "transform": "ternary",
      "if": "{{step.has_thread_id}}",
      "then": "{{step.thread_body}}",
      "else": "{{step.single_body}}"
    },
    {
      "id": "body_present",
      "transform": "compare",
      "left": "{{step.body}}",
      "operator": "is_not_empty"
    },
    {
      "id": "skip_empty",
      "transform": "compare",
      "left": "{{step.body_present}}",
      "operator": "not_equal",
      "right": true
    },
    {
      "id": "protect",
      "transform": "pii-protect",
      "data": {
        "from": "{{step.from_email}}",
        "subject": "{{step.subject}}",
        "body": "{{step.body}}"
      },
      "fields": [
        {
          "path": "from",
          "kind": "email"
        },
        {
          "path": "subject",
          "kind": "content"
        },
        {
          "path": "body",
          "kind": "content"
        }
      ]
    },
    {
      "id": "classify",
      "skip_when": "{{step.skip_empty}} equal true",
      "op": "core.ai.classify",
      "args": {
        "llm.data": "Subject: {{step.protect.aliased.subject}}\n\n{{step.protect.aliased.body}}",
        "llm.categories": [
          "commitment_made",
          "no_commitment"
        ],
        "llm.context": "Does this message contain a COMMITMENT — someone stating they will do a specific thing, by them or by a named party? A request asking the reader to do something is NOT a commitment. Newsletters, receipts and social messages are not commitments.",
        "llm.model_hint": "fast"
      }
    },
    {
      "id": "not_commitment",
      "transform": "compare",
      "left": "{{step.classify.category}}",
      "operator": "not_equal",
      "right": "commitment_made"
    },
    {
      "id": "skip_extract",
      "transform": "any",
      "values": [
        "{{step.skip_empty}}",
        "{{step.not_commitment}}"
      ]
    },
    {
      "id": "extract",
      "skip_when": "{{step.skip_extract}} equal true",
      "op": "core.ai.extract",
      "args": {
        "llm.data": "Subject: {{step.protect.aliased.subject}}\n\n{{step.protect.aliased.body}}",
        "llm.fields": [
          "statement",
          "direction",
          "promised_for_at_iso",
          "counterparty_email",
          "monetary_amount",
          "monetary_currency"
        ],
        "llm.model_hint": "fast"
      }
    },
    {
      "id": "restore",
      "transform": "pii-restore",
      "data": "{{step.extract}}",
      "ledger_handle": "{{step.protect.ledger_handle}}"
    },
    {
      "id": "defaults_2",
      "transform": "defaults",
      "fields": {
        "extracted_statement": {
          "value": "{{step.restore.restored.statement}}",
          "fallback": ""
        },
        "extracted_direction": {
          "value": "{{step.restore.restored.direction}}",
          "fallback": "inbound"
        },
        "extracted_counterparty_email": {
          "value": "{{step.restore.restored.counterparty_email}}",
          "fallback": ""
        }
      }
    },
    {
      "id": "counterparty_email",
      "transform": "trim",
      "input": "{{step.extracted_counterparty_email}}"
    },
    {
      "id": "defaults_3",
      "transform": "defaults",
      "fields": {
        "extracted_monetary_amount": {
          "value": "{{step.restore.restored.monetary_amount}}",
          "fallback": ""
        },
        "extracted_monetary_currency": {
          "value": "{{step.restore.restored.monetary_currency}}",
          "fallback": ""
        }
      }
    },
    {
      "id": "promised_for_at",
      "transform": "date_parse",
      "input": "{{step.restore.restored.promised_for_at_iso}}"
    },
    {
      "id": "has_monetary",
      "transform": "all",
      "conditions": [
        "{{step.extracted_monetary_amount}} is_not_empty",
        "{{step.extracted_monetary_currency}} is_not_empty"
      ]
    },
    {
      "id": "monetary_value",
      "skip_when": "{{step.has_monetary}} not_equal true",
      "transform": "merge",
      "sources": [
        {
          "amount": "{{step.extracted_monetary_amount}}",
          "currency": "{{step.extracted_monetary_currency}}"
        }
      ]
    },
    {
      "id": "missing_statement",
      "transform": "compare",
      "left": "{{step.extracted_statement}}",
      "operator": "is_empty"
    },
    {
      "id": "skip_create",
      "transform": "any",
      "values": [
        "{{step.skip_empty}}",
        "{{step.not_commitment}}",
        "{{step.missing_statement}}"
      ]
    },
    {
      "id": "resolve_counterparty",
      "skip_when": "{{step.counterparty_email}} is_empty",
      "op": "core.contact.resolve",
      "args": {
        "email": "{{step.counterparty_email}}"
      }
    },
    {
      "id": "create",
      "skip_when": "{{step.skip_create}} equal true",
      "op": "core.work-entity.commitment.create",
      "args": {
        "direction": "{{step.extracted_direction}}",
        "statement": "{{step.extracted_statement}}",
        "derivation": "mail_extracted",
        "promised_for_at": "{{step.promised_for_at}}",
        "expiry_policy": "escalate_overdue",
        "monetary_value": "{{step.monetary_value}}",
        "counterparty_contact_id": "{{step.resolve_counterparty.contact.email}}",
        "derived_from_mail_thread_id": "{{step.thread_id}}"
      }
    },
    {
      "id": "card",
      "transform": "to_summary",
      "fields": [
        {
          "label": "Mail thread",
          "value": "{{step.thread_id}}"
        },
        {
          "label": "Subject",
          "value": "{{step.subject}}"
        },
        {
          "label": "Statement",
          "value": "{{step.extracted_statement}}"
        },
        {
          "label": "Direction",
          "value": "{{step.extracted_direction}}"
        },
        {
          "label": "Classification",
          "value": "{{step.classify.category}}"
        },
        {
          "label": "Counterparty email",
          "value": "{{step.extracted_counterparty_email}}"
        },
        {
          "label": "Counterparty contact",
          "value": "{{step.resolve_counterparty.contact.email}}"
        },
        {
          "label": "Monetary amount",
          "value": "{{step.extracted_monetary_amount}}"
        },
        {
          "label": "Monetary currency",
          "value": "{{step.extracted_monetary_currency}}"
        },
        {
          "label": "Skipped",
          "value": "{{step.skip_create}}"
        },
        {
          "label": "Commitment ID",
          "value": "{{step.create.commitment.id}}"
        }
      ]
    }
  ],
  "output": {
    "render": [
      {
        "type": "summary",
        "source": "step.card"
      }
    ]
  }
}
