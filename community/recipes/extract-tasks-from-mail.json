{
  "recipe_id": "extract-tasks-from-mail",
  "chat_exposed": true,
  "version": 1,
  "ttl": 60,
  "metadata": {
    "name": "Extract tasks from mail (D-145 PA10)",
    "description": "Use “Extract tasks from mail” in Recued. Extract action items from an inbound email into Recued's task tracker — title, due date, and priority (low / medium / high). Thread-aware; fires automatically on each inbound message; records only extractions above the confidence floor (default 0.7).",
    "author": "recued-core",
    "supported_platforms": [],
    "tags": ["email", "mail", "task", "work-entity", "reactive", "silent-producer", "pack:personal-organizer", "ai_surface"],
    "budget_ms": 30000
  },
  "variables": {
    "confidence_threshold": {
      "label": "Minimum extraction confidence (0..1) to create a task row",
      "type": "number",
      "default": 0.7
    },
    "container_names": {
      "label": "Destination container",
      "type": "object",
      "optional": true,
      "default": {},
      "help": "Optional. File the extracted task(s) in a named vendor container, keyed by its dependency ref: { 'project': 'Roadmap' } (Asana) or { 'team': 'Core' } (Linear). Leave empty to use the Source's default destination."
    }
  },
  "requires": [],
  "event_triggers": [
    { "event": "data.mail.**.created" }
  ],
  "prefetch_steps": [
    {
      "id": "message",
      "op": "core.mail.get",
      "args": {
        "slug": "{{context.event.payload.slug}}",
        "record_id": "{{context.event.payload.record_id}}"
      }
    }
  ],
  "steps": [
    {
      "id": "subject",
      "transform": "default",
      "value": "{{step.message.record.hot_fields.subject}}",
      "fallback": ""
    },
    {
      "id": "from_email",
      "transform": "default",
      "value": "{{step.message.record.hot_fields.from}}",
      "fallback": ""
    },
    {
      "id": "thread_id",
      "transform": "default",
      "value": "{{step.message.record.hot_fields.thread_id}}",
      "fallback": ""
    },
    {
      "id": "has_thread_id",
      "transform": "compare",
      "left": "{{step.thread_id}}",
      "operator": "is_not_empty"
    },
    {
      "id": "thread",
      "skip_when": "{{step.has_thread_id}} not_equal true",
      "op": "core.mail.thread-read",
      "args": {
        "slug": "{{context.event.payload.slug}}",
        "thread_id": "{{step.thread_id}}",
        "max_messages": 5
      }
    },
    {
      "id": "thread_messages",
      "transform": "default",
      "value": "{{step.thread.messages}}",
      "fallback": []
    },
    {
      "id": "thread_body_reads",
      "op": "core.mail.body-read",
      "foreach": "{{step.thread_messages}}",
      "args": {
        "slug": "{{context.event.payload.slug}}",
        "record_id": "{{item.record_id}}",
        "max_chars": 32000
      }
    },
    {
      "id": "thread_messages_with_body",
      "transform": "filter",
      "array": "{{step.thread_body_reads}}",
      "field": "result.body",
      "operator": "is_not_empty"
    },
    {
      "id": "thread_body_segments",
      "transform": "pluck",
      "array": "{{step.thread_messages_with_body}}",
      "field": "result.body"
    },
    {
      "id": "thread_body",
      "transform": "join",
      "array": "{{step.thread_body_segments}}",
      "separator": "\n\n---\n\n"
    },
    {
      "id": "single_body_read",
      "skip_when": "{{step.has_thread_id}} equal true",
      "op": "core.mail.body-read",
      "args": {
        "slug": "{{context.event.payload.slug}}",
        "record_id": "{{context.event.payload.record_id}}",
        "max_chars": 32000
      }
    },
    {
      "id": "single_body",
      "transform": "default",
      "value": "{{step.single_body_read.body}}",
      "fallback": ""
    },
    {
      "id": "body",
      "transform": "ternary",
      "if": "{{step.has_thread_id}}",
      "then": "{{step.thread_body}}",
      "else": "{{step.single_body}}"
    },
    {
      "id": "body_present",
      "transform": "compare",
      "left": "{{step.body}}",
      "operator": "is_not_empty"
    },
    {
      "id": "skip_empty",
      "transform": "compare",
      "left": "{{step.body_present}}",
      "operator": "not_equal",
      "right": true
    },
    {
      "id": "protect",
      "transform": "pii-protect",
      "data": {
        "from": "{{step.from_email}}",
        "subject": "{{step.subject}}",
        "body": "{{step.body}}"
      },
      "fields": [
        { "path": "from", "kind": "email" },
        { "path": "subject", "kind": "content" },
        { "path": "body", "kind": "content" }
      ]
    },
    {
      "id": "extract",
      "skip_when": "{{step.skip_empty}} equal true",
      "op": "core.ai.extract",
      "args": {
        "llm.data": "Subject: {{step.protect.aliased.subject}}\n\n{{step.protect.aliased.body}}\n\n[Field guidance] delegated_assignee_email: the email address of a specific named person this message EXPLICITLY delegates the task to. Return null if the task is directed at the reader/recipient, is a general request, or names no third-party owner — and never use the sender's own signature address.",
        "llm.fields": [
          "title",
          "due_at_iso",
          "priority",
          "delegated_assignee_email",
          "extraction_confidence"
        ],
        "llm.model_hint": "fast"
      }
    },
    {
      "id": "restore",
      "transform": "pii-restore",
      "data": "{{step.extract}}",
      "ledger_handle": "{{step.protect.ledger_handle}}"
    },
    {
      "id": "extracted_title",
      "transform": "default",
      "value": "{{step.restore.restored.title}}",
      "fallback": ""
    },
    {
      "id": "extracted_priority",
      "transform": "default",
      "value": "{{step.restore.restored.priority}}",
      "fallback": "medium"
    },
    {
      "id": "extracted_confidence",
      "transform": "default",
      "value": "{{step.restore.restored.extraction_confidence}}",
      "fallback": 0
    },
    {
      "id": "extracted_assignee_email",
      "transform": "default",
      "value": "{{step.restore.restored.delegated_assignee_email}}",
      "fallback": ""
    },
    {
      "id": "assignee_email",
      "transform": "trim",
      "input": "{{step.extracted_assignee_email}}"
    },
    {
      "id": "due_at",
      "transform": "date_parse",
      "input": "{{step.restore.restored.due_at_iso}}"
    },
    {
      "id": "below_threshold",
      "transform": "compare",
      "left": "{{step.extracted_confidence}}",
      "operator": "less",
      "right": "{{config.confidence_threshold}}"
    },
    {
      "id": "missing_title",
      "transform": "compare",
      "left": "{{step.extracted_title}}",
      "operator": "is_empty"
    },
    {
      "id": "skip_create",
      "transform": "any",
      "values": [
        "{{step.skip_empty}}",
        "{{step.below_threshold}}",
        "{{step.missing_title}}"
      ]
    },
    {
      "id": "resolve_assignee",
      "skip_when": "{{step.assignee_email}} is_empty",
      "op": "core.contact.resolve",
      "args": {
        "email": "{{step.assignee_email}}"
      }
    },
    {
      "id": "create",
      "skip_when": "{{step.skip_create}} equal true",
      "op": "core.work-entity.task.create",
      "args": {
        "title": "{{step.extracted_title}}",
        "due_at": "{{step.due_at}}",
        "priority": "{{step.extracted_priority}}",
        "assigned_contact_id": "{{step.resolve_assignee.contact.email}}",
        "linked_mail_thread_id": "{{step.thread_id}}",
        "container_names": "{{config.container_names}}"
      }
    },
    {
      "id": "card",
      "transform": "to_summary",
      "fields": [
        { "label": "Mail thread", "value": "{{step.thread_id}}" },
        { "label": "Subject",     "value": "{{step.subject}}" },
        { "label": "Task title",  "value": "{{step.extracted_title}}" },
        { "label": "Priority",    "value": "{{step.extracted_priority}}" },
        { "label": "Confidence",  "value": "{{step.extracted_confidence:number}}" },
        { "label": "Assignee email",   "value": "{{step.extracted_assignee_email}}" },
        { "label": "Assignee contact", "value": "{{step.resolve_assignee.contact.email}}" },
        { "label": "Skipped",     "value": "{{step.skip_create}}" },
        { "label": "Task ID",     "value": "{{step.create.task.id}}" }
      ]
    }
  ],
  "output": {
    "render": [
      { "type": "summary", "source": "step.card" }
    ]
  }
}
