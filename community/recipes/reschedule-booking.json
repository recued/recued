{
  "recipe_id": "reschedule-booking",
  "chat_exposed": false,
  "version": 1,
  "ttl": 60,
  "requires": [],
  "metadata": {
    "name": "Reschedule a booking",
    "description": "Use “Reschedule a booking” in Recued. It carries out the named workflow using the connections and settings you choose.",
    "author": "recued-core",
    "supported_platforms": [],
    "tags": [
      "calendar",
      "reschedule",
      "booking",
      "reception",
      "notify"
    ],
    "budget_ms": 30000
  },
  "variables": {
    "booking_id": {
      "label": "Booking id",
      "type": "string",
      "default": ""
    },
    "new_start_at": {
      "label": "New start (unix ms)",
      "type": "number",
      "default": null
    },
    "new_end_at": {
      "label": "New end (unix ms)",
      "type": "number",
      "default": null
    },
    "notify_visitor": {
      "label": "Tell the visitor their booking moved",
      "type": "boolean",
      "default": false
    },
    "sender_mail_instance": {
      "label": "Send from (data.mail account)",
      "type": "string",
      "default": ""
    }
  },
  "steps": [
    {
      "id": "ready",
      "transform": "all",
      "conditions": [
        "{{config.booking_id}} is_not_empty",
        "{{config.new_start_at}} is_not_null",
        "{{config.new_end_at}} is_not_null"
      ]
    },
    {
      "id": "reschedule",
      "skip_when": "{{step.ready}} not_equal true",
      "op": "core.work-entity.booking.update",
      "args": {
        "id": "{{config.booking_id}}",
        "slot_start_at": "{{config.new_start_at}}",
        "slot_end_at": "{{config.new_end_at}}"
      }
    },
    {
      "id": "moved",
      "transform": "compare",
      "left": "{{step.reschedule.booking.id}}",
      "operator": "is_not_null"
    },
    {
      "id": "new_time",
      "transform": "date_format",
      "date": "{{config.new_start_at}}",
      "format": "YYYY-MM-DD HH:mm"
    },
    {
      "id": "notify_ready",
      "transform": "all",
      "conditions": [
        "{{config.notify_visitor}} equal true",
        "{{step.moved}} equal true",
        "{{config.sender_mail_instance}} is_not_empty"
      ]
    },
    {
      "id": "subject",
      "skip_when": "{{step.notify_ready}} not_equal true",
      "transform": "template",
      "template": "Your booking has moved to {{step.new_time}}"
    },
    {
      "id": "body",
      "skip_when": "{{step.notify_ready}} not_equal true",
      "transform": "template",
      "template": "Hi — the time for your booking has changed. It is now {{step.new_time}}. If the new time does not work for you, just reply to this message and we will sort it out."
    },
    {
      "id": "notify",
      "skip_when": "{{step.notify_ready}} not_equal true",
      "op": "core.mail.notify-booking-visitor",
      "args": {
        "booking_id": "{{config.booking_id}}",
        "sender_mail_instance": "{{config.sender_mail_instance}}",
        "subject": "{{step.subject}}",
        "body": "{{step.body}}"
      }
    },
    {
      "id": "visitor_told",
      "transform": "default",
      "value": "{{step.notify.notified}}",
      "fallback": false
    },
    {
      "id": "card",
      "transform": "to_summary",
      "fields": [
        {
          "label": "Booking",
          "value": "{{config.booking_id}}"
        },
        {
          "label": "Rescheduled",
          "value": "{{step.moved}}"
        },
        {
          "label": "New start",
          "value": "{{config.new_start_at:date}}"
        },
        {
          "label": "New end",
          "value": "{{config.new_end_at:date}}"
        },
        {
          "label": "Visitor told",
          "value": "{{step.visitor_told}}"
        }
      ]
    }
  ],
  "output": {
    "render": [
      {
        "type": "summary",
        "source": "step.card"
      }
    ]
  }
}
