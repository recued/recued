{
  "recipe_id": "reschedule-booking-managed",
  "chat_exposed": false,
  "version": 1,
  "ttl": 60,
  "requires": [],
  "metadata": {
    "name": "Reschedule a booking (managed door)",
    "description": "Use “Reschedule a booking (managed door)” in Recued. It carries out the named workflow using the connections and settings you choose.",
    "author": "recued-core",
    "supported_platforms": [],
    "tags": [
      "calendar",
      "reschedule",
      "booking",
      "reception",
      "managed-door"
    ],
    "budget_ms": 30000
  },
  "variables": {
    "booking_id": {
      "label": "Booking id",
      "type": "string",
      "default": ""
    },
    "new_start_at": {
      "label": "New start (unix ms)",
      "type": "number",
      "default": null
    },
    "new_end_at": {
      "label": "New end (unix ms)",
      "type": "number",
      "default": null
    }
  },
  "steps": [
    {
      "id": "ready",
      "transform": "all",
      "conditions": [
        "{{config.booking_id}} is_not_empty",
        "{{config.new_start_at}} is_not_null",
        "{{config.new_end_at}} is_not_null"
      ]
    },
    {
      "id": "manage_target_booking_id",
      "transform": "coalesce",
      "values": ["{{config.booking_id}}", ""]
    },
    {
      "id": "reschedule",
      "skip_when": "{{step.ready}} not_equal true",
      "op": "core.work-entity.booking.update",
      "args": {
        "id": "{{config.booking_id}}",
        "slot_start_at": "{{config.new_start_at}}",
        "slot_end_at": "{{config.new_end_at}}"
      }
    }
  ],
  "output": {
    "render": []
  }
}
